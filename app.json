{
  "expo": {
    "name": "aibo-movil",
    "slug": "aibo-movil",
    "scheme": "aibo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "AIBO usa tus fotos para mostrar la imagen de cada medicamento.",
          "cameraPermission": "AIBO usa la cámara para sacarle una foto a la caja del medicamento."
        }
      ]
    ]
  }
}
